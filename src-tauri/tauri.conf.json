{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AVD",
  "version": "1.0.11",
  "identifier": "com.mattpocock.avd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "shell": {
      "open": "^.*"
    }
  },
  "app": {
    "windows": [
      {
        "title": "AVD",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "externalBin": [
      "bin/yt-dlp",
      "bin/ffmpeg",
      "bin/rclone"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "wix": {
        "language": "zh-TW"
      }
    }
  }
}
