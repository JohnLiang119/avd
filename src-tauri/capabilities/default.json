{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "dialog:default",
    "os:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "bin/yt-dlp",
          "args": true,
          "sidecar": true
        },
        {
          "name": "bin/ffmpeg",
          "args": true,
          "sidecar": true
        },
        {
          "name": "bin/rclone",
          "args": true,
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bin/yt-dlp",
          "args": true,
          "sidecar": true
        },
        {
          "name": "bin/ffmpeg",
          "args": true,
          "sidecar": true
        },
        {
          "name": "bin/rclone",
          "args": true,
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD"
        }
      ]
    },
    "store:default"
  ]
}